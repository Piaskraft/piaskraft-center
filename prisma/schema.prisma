generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TaskAssignee {
  ADMIN
  OPERATOR
  BOTH
}

enum TaskAuthor {
  ADMIN
  OPERATOR
}

enum TaskCategory {
  PIASKRAFT
  PRESTASHOP
  EBAY
  BASELINKER
  MJW
  MARKETING
  DOCUMENTS
  PHONE
  PRIVATE
  OTHER
}

enum TaskPriority {
  LOW
  NORMAL
  IMPORTANT
  URGENT
  TODAY
}

enum TaskStatus {
  NEW
  TODO
  IN_PROGRESS
  WAITING_REVIEW
  DONE
  CANCELLED
}

enum NotificationType {
  TASK_CREATED
  TASK_STATUS_CHANGED
  TASK_COMMENT_ADDED
}

model Task {
  id            Int            @id @default(autoincrement())
  title         String
  description   String         @db.Text
  assignedTo    TaskAssignee
  category      TaskCategory
  priority      TaskPriority   @default(NORMAL)
  status        TaskStatus     @default(NEW)
  archivedAt    DateTime?
  date          DateTime?      @db.Date
  time          DateTime?      @db.Time(0)
  createdBy     TaskAuthor
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  comments      TaskComment[]
  notifications Notification[]

  @@index([date])
  @@index([assignedTo, status])
}

model TaskComment {
  id        Int        @id @default(autoincrement())
  taskId    Int
  author    TaskAuthor
  content   String     @db.Text
  createdAt DateTime   @default(now())
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  recipient TaskAuthor
  actor     TaskAuthor?
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  taskId    Int?
  createdAt DateTime         @default(now())
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([recipient, isRead, createdAt])
  @@index([taskId])
}
enum PrestaWorkflowStatus {
  TO_PREPARE
  IN_PROGRESS
  TO_REVIEW
  READY
  ADDED
  REJECTED
}

enum EbayWorkflowStatus {
  TO_PREPARE
  IN_PROGRESS
  TO_REVIEW
  READY
  LISTED
  REJECTED
}

model WorkProduct {
  id              Int                   @id @default(autoincrement())
  name            String
  ean             String?               @unique
  sku             String?
  manufacturer    String?
  source          String
  sourceUrl       String?
  sourceProductId String?

  targetPresta    Boolean               @default(false)
  targetEbay      Boolean               @default(false)
  prestaStatus    PrestaWorkflowStatus?
  ebayStatus      EbayWorkflowStatus?
  prestaAssignee  TaskAuthor?
  ebayAssignee    TaskAuthor?

  piaskraftUrl    String?
  prestaProductId String?
  prestaAddedAt   DateTime?

  ebayUrl         String?
  ebayItemId      String?
  ebayListedAt    DateTime?

  notes           String?               @db.Text
  createdBy       TaskAuthor
  archivedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([source, sku])
  @@unique([source, sourceProductId])
  @@index([prestaAssignee, prestaStatus])
  @@index([ebayAssignee, ebayStatus])
  @@index([archivedAt])
}